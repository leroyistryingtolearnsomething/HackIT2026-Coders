# Copy to .env and adjust. All values are optional.

# Port the server listens on (it also serves the website).
PORT=3000

# Code volunteers type to switch on Volunteer mode. CHANGE THIS before sharing the site.
VOLUNTEER_CODE=kampung2026

# Simulated volunteer that answers new cases when no human volunteer replies first.
# Set to false once real volunteers are using the system.
AUTO_REPLY=true

# Pause: seconds a resident's Circle has to answer before volunteers are alerted too.
# Shorten it (e.g. 30) for a live demo.
PAUSE_ESCALATE_SECONDS=90

# Where the SQLite database and uploaded images are stored.
# DATA_DIR=./data

# AI assistant ("Ask AI" in the header). Choose the AI service: gemini (free tier) or anthropic (Claude, paid).
# If AI_PROVIDER is left out, whichever key below is filled in is used.
# With no key, the assistant shows "not switched on yet" while the rest of the site works.
AI_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey
# On the free plan Google may use messages to improve its products.
GEMINI_API_KEY=

# Paid key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: a different model, e.g. gemini-2.5-flash. Defaults: gemini-flash-latest / claude-opus-5-5
# ASSISTANT_MODEL=

# Most assistant replies the whole site may request per day (protects your bill).
ASSISTANT_DAILY_LIMIT=500

# Most AI translation requests per day, for posts read in 华语, Malay or Tamil.
# Each text is translated once per language and then saved, so this is rarely reached.
# TRANSLATE_DAILY_LIMIT=1000
# Model for translating (Gemini only). Default: gemini-flash-lite-latest
# TRANSLATE_MODEL=
