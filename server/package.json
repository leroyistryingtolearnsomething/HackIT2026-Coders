{
  "name": "kampung-watch-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Kampung Watch: reports, community posts, volunteer cases and live updates",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/index.js",
